# Copy this file to .env and fill in your own key. Never commit .env.
# Get a free Gemini API key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for discovery. Verify current availability at
# https://ai.google.dev/gemini-api/docs/models if this 404s for you.
GEMINI_MODEL=gemini-3.6-flash

# Base URL of the running mock bank app (see mock-bank-app/ workspace)
MOCK_APP_BASE_URL=http://localhost:4000
